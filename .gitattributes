# 统一换行，避免 Windows 检出后整仓 diff 变脏
* text=auto eol=lf

*.sh      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf

# 二进制，不要当文本处理
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     text eol=lf
*.asar    binary
*.exe     binary
